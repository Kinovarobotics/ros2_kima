<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="kortex_ros2_control" params="
    name
    prefix
    use_fake_hardware:=false
    fake_sensor_commands:=false
    sim_gazebo:=false
    sim_ignition:=false
    sim_isaac:=false
    isaac_joint_commands:=/isaac_joint_commands
    isaac_joint_states:=/isaac_joint_states
    use_internal_bus_gripper_comm:=true
    tf_prefix
    initial_positions:=${dict(joint_1=0.0,joint_2=0.0,joint_3=0.0,joint_4=0.0,joint_5=0.0,joint_6=0.0,joint_7=0.0)}
    robot_ip
    username
    password
    port
    port_realtime
    session_inactivity_timeout_ms
    connection_inactivity_timeout_ms
    gripper_joint_name
    gripper_max_velocity:=100.0
    gripper_max_force:=100.0
    moveit_active:=false
    ethercat_lib_path:=/usr/local/lib/libethercat.so
    network_topology_file:=USE_PACKAGE_DEFAULT
    arm_part_number:=ARM-L3M000-001
    arm_part_number_revision:=A
    arm_serial_number:=0001
    arm_nb_actuators:=7
    slave_pos_range_min:=0
    slave_pos_range_max:=13
    network_thread_cpu_core:=-1
    control_thread_cpu_core:=-1
    gravity_x:=0.0
    gravity_y:=0.0
    gravity_z:=-9.81">

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${sim_gazebo}">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
        <xacro:if value="${sim_ignition}">
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </xacro:if>
        <xacro:if value="${sim_isaac}">
          <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
          <param name="joint_commands_topic">${isaac_joint_commands}</param>
          <param name="joint_states_topic">${isaac_joint_states}</param>
        </xacro:if>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="fake_sensor_commands">${fake_sensor_commands}</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <xacro:unless value="${use_fake_hardware or sim_gazebo or sim_ignition or sim_isaac}">
          <!-- KIMA over EtherCAT via Kinova's Robot Control Library (RCL). -->
          <plugin>kortex_driver/KortexMultiInterfaceHardware</plugin>
          <param name="ethercat_lib_path">${ethercat_lib_path}</param>
          <!-- Default to the topology shipped with kortex_description; override
               by passing network_topology_file to the macro. -->
          <xacro:if value="${network_topology_file == 'USE_PACKAGE_DEFAULT'}">
            <param name="network_topology_file">$(find kortex_description)/arms/linkm/7dof/config/network_topology_1_arm.yaml</param>
          </xacro:if>
          <xacro:unless value="${network_topology_file == 'USE_PACKAGE_DEFAULT'}">
            <param name="network_topology_file">${network_topology_file}</param>
          </xacro:unless>
          <param name="arm_part_number">${arm_part_number}</param>
          <param name="arm_part_number_revision">${arm_part_number_revision}</param>
          <param name="arm_serial_number">${arm_serial_number}</param>
          <param name="arm_nb_actuators">${arm_nb_actuators}</param>
          <param name="slave_pos_range_min">${slave_pos_range_min}</param>
          <param name="slave_pos_range_max">${slave_pos_range_max}</param>
          <param name="network_thread_cpu_core">${network_thread_cpu_core}</param>
          <param name="control_thread_cpu_core">${control_thread_cpu_core}</param>
          <param name="gravity_x">${gravity_x}</param>
          <param name="gravity_y">${gravity_y}</param>
          <param name="gravity_z">${gravity_z}</param>
          <param name="prefix">${prefix}</param>
        </xacro:unless>
      </hardware>
      <!-- joint_1: continuous rotation (±2π) -->
      <joint name="${prefix}joint_1">
        <command_interface name="position">
          <param name="min">{-2*pi}</param>
          <param name="max">{2*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_1']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <!-- joint_2: elbow ±1.9887 rad -->
      <joint name="${prefix}joint_2">
        <command_interface name="position">
          <param name="min">-1.9887</param>
          <param name="max">1.9887</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_2']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <!-- joint_3: continuous rotation (±2π) -->
      <joint name="${prefix}joint_3">
        <command_interface name="position">
          <param name="min">{-2*pi}</param>
          <param name="max">{2*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_3']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <!-- joint_4: elbow ±2.4248 rad -->
      <joint name="${prefix}joint_4">
        <command_interface name="position">
          <param name="min">-2.4248</param>
          <param name="max">2.4248</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_4']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <!-- joint_5: continuous rotation (±2π) -->
      <joint name="${prefix}joint_5">
        <command_interface name="position">
          <param name="min">{-2*pi}</param>
          <param name="max">{2*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_5']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <!-- joint_6: wrist ±1.8317 rad -->
      <joint name="${prefix}joint_6">
        <command_interface name="position">
          <param name="min">-1.8317</param>
          <param name="max">1.8317</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_6']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <!-- joint_7: continuous rotation (±2π) -->
      <joint name="${prefix}joint_7">
        <command_interface name="position">
          <param name="min">{-2*pi}</param>
          <param name="max">{2*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint_7']}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <!-- No gripper: KIMA is arm-only on the EtherCAT bus and the RCL API has
           no gripper command path. The gripper (mock) joint is only kept for
           the simulation/fake-hardware plugins above. -->
    </ros2_control>
  </xacro:macro>

</robot>
